{
  "name": "nuplex-app",
  "version": "1.0.0",
  "private": true,
  "description": "NUPLEX iOS/Android native shell (Capacitor)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev": "vite",
    "cap": "node scripts/cap.mjs",
    "sync": "npm run build && node scripts/cap.mjs sync",
    "open:ios": "node scripts/cap.mjs open ios",
    "open:android": "node scripts/cap.mjs open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/ios": "8.5.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-badge": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
